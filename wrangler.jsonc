{
  "vars": {
    "APP_NAME": "Seoul Moment",
  },

  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "line-gateway",

  "main": "src/index.ts",

  "compatibility_date": "2026-07-16",

  "observability": {
    "enabled": true,
  },

  "upload_source_maps": true,

  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./public/",
    "binding": "ASSETS",
  },
}
